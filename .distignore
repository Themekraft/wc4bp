/patch
/codeception.yml
/phpunit.xml.dist
/phpcs.ruleset.xml
/php-git-hooks.yml
/.env.example
/.eslintrc.json
/gulpfile.js
/package.json
/package-lock.json
/readme.md
/includes/admin/pricing-page/package-lock.json
